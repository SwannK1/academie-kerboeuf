{
  "name": "academie-kerboeuf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "local": "lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf .next && next dev --webpack",
    "open": "open http://localhost:3000",
    "build": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "build:if-needed": "test -d .next/server || npm run build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:quick": "node scripts/link-audit/route-audit.mjs quick",
    "test:routes": "node scripts/link-audit/route-audit.mjs full",
    "validate": "rm -rf .next && npm run lint && npx tsc --noEmit && npm run build && npm run test:unit && npm run test:e2e && npm run test:a11y && npm run test:quick && npm run test:routes"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
