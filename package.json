{
  "name": "academie-kerboeuf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "local": "lsof -ti:3000 2>/dev/null | xargs kill -9 2>/dev/null; rm -rf .next && next dev --webpack",
    "open": "open http://localhost:3000",
    "build": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=8192' next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "routes:check": "node scripts/check-routes.mjs",
    "routes:check:quick": "node scripts/check-routes.mjs --quick",
    "validate:quick": "npm run lint && npm run typecheck && npm run test:unit",
    "validate": "npm run lint && npm run typecheck && rm -rf .next && npm run build && npm run test:unit && npm run test:e2e && npm run routes:check:quick"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
